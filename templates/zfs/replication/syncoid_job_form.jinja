{% extends "layout_main.jinja" %}

{% block content %}
<div class="container-page max-w-5xl">
    <!-- Breadcrumb -->
    <nav class="text-sm mb-6" aria-label="Breadcrumb">
        <ol class="flex items-center space-x-2">
            <li><a href="/" class="text-primary-400 hover:text-primary-300 transition-colors">Home</a></li>
            <li class="text-text-tertiary">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
            </li>
            <li><a href="/zfs/replication" class="text-primary-400 hover:text-primary-300 transition-colors">Replication</a></li>
            <li class="text-text-tertiary">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
            </li>
            <li><a href="/zfs/replication/syncoid" class="text-primary-400 hover:text-primary-300 transition-colors">Syncoid</a></li>
            <li class="text-text-tertiary">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
            </li>
            <li class="text-text-primary font-medium">{% if job and job.id %}Edit Job{% else %}Create Job{% endif %}</li>
        </ol>
    </nav>

    <!-- Page Header -->
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-text-primary mb-2">{% if job and job.id %}Edit Scheduled Syncoid Job{% else %}Create Scheduled Syncoid Job{% endif %}</h1>
        <p class="text-text-secondary">Scheduled jobs run automatically via the operating system scheduler and use SSH Manager connections for remote replication</p>
    </div>

    {% if error %}
        <div id="error-message" class="bg-danger-900/30 border border-danger-700 text-danger-400 px-4 py-3 rounded-lg mb-6 flex items-center">
            <svg class="w-5 h-5 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span><strong>Error:</strong> {{ error }}</span>
        </div>
    {% endif %}

    <div class="card mb-6">
        <div class="card-body">
            <form method="post" action="/zfs/replication/syncoid/jobs/save" id="job-form">
                {% if job and job.id %}
                <input type="hidden" name="job_id" value="{{ job.id }}">
                {% endif %}

                <!-- Job Identity -->
                <div class="mb-6">
                    <h3 class="font-semibold text-lg mb-4 text-text-primary flex items-center">
                        <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-primary-500 text-white text-sm font-bold mr-2">1</span>
                        Job Details
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="form-label" for="name">Job Name <span class="text-danger-400">*</span></label>
                            <input type="text" name="name" id="name" required class="form-input"
                                   value="{{ job.name if job else '' }}" placeholder="e.g., Nightly tank backup">
                        </div>
                        <div>
                            <label class="form-label" for="replication_type">Direction</label>
                            <select name="replication_type" id="replication_type" class="form-select">
                                <option value="local" {% if job and job.replication_type == 'local' %}selected{% endif %}>Local (this system only)</option>
                                <option value="push" {% if job and job.replication_type == 'push' %}selected{% endif %}>Push (local source to remote target)</option>
                                <option value="pull" {% if job and job.replication_type == 'pull' %}selected{% endif %}>Pull (remote source to local target)</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Connection and Datasets -->
                <div class="mb-6">
                    <h3 class="font-semibold text-lg mb-4 text-text-primary flex items-center">
                        <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-success-500 text-white text-sm font-bold mr-2">2</span>
                        Datasets
                    </h3>
                    <div id="connection-field" class="mb-4 {% if not job or job.replication_type == 'local' or not job.replication_type %}hidden{% endif %}">
                        <label class="form-label" for="ssh_connection_id">SSH Connection <span class="text-danger-400">*</span></label>
                        <select name="ssh_connection_id" id="ssh_connection_id" class="form-select">
                            <option value="">-- Select Connection --</option>
                            {% for conn in ssh_connections %}
                            <option value="{{ conn.id }}" {% if job and job.ssh_connection_id == conn.id %}selected{% endif %}>
                                {{ conn.name }} ({{ conn.username }}@{{ conn.host }}{% if conn.port != 22 %}:{{ conn.port }}{% endif %})
                            </option>
                            {% endfor %}
                        </select>
                        <p class="text-text-tertiary text-xs mt-1">
                            The connection's key, host, and port are resolved at each run.
                            Manage connections in <a href="/utils/ssh" class="text-primary-400 hover:text-primary-300">Utilities &gt; SSH Manager</a>.
                        </p>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="form-label" for="source_dataset">Source Dataset <span class="text-danger-400">*</span></label>
                            <input type="text" name="source_dataset" id="source_dataset" required class="form-input"
                                   value="{{ job.source_dataset if job else '' }}" placeholder="pool/dataset">
                            <p class="text-text-tertiary text-xs mt-1" id="source-hint">Dataset name only; the SSH connection provides the remote host for pull jobs</p>
                        </div>
                        <div>
                            <label class="form-label" for="target_dataset">Target Dataset <span class="text-danger-400">*</span></label>
                            <input type="text" name="target_dataset" id="target_dataset" required class="form-input"
                                   value="{{ job.target_dataset if job else '' }}" placeholder="pool/backup/dataset">
                            <p class="text-text-tertiary text-xs mt-1" id="target-hint">Dataset name only; the SSH connection provides the remote host for push jobs</p>
                        </div>
                    </div>
                </div>

                <!-- Schedule -->
                <div class="mb-6">
                    <h3 class="font-semibold text-lg mb-4 text-text-primary flex items-center">
                        <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-info-500 text-white text-sm font-bold mr-2">3</span>
                        Schedule
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="form-label" for="schedule_preset">Preset</label>
                            <select id="schedule_preset" class="form-select">
                                <option value="">Custom</option>
                                {% for preset in schedule_presets %}
                                <option value="{{ preset.expression }}" {% if job and job.schedule == preset.expression %}selected{% endif %}>{{ preset.label }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div>
                            <label class="form-label" for="schedule">Cron Expression <span class="text-danger-400">*</span></label>
                            <input type="text" name="schedule" id="schedule" required class="form-input"
                                   value="{{ job.schedule if job else '0 2 * * *' }}" placeholder="0 2 * * *">
                            <p id="schedule-status" class="text-text-tertiary text-xs mt-1">minute hour day month weekday (local time)</p>
                        </div>
                    </div>
                    <div id="next-runs" class="hidden mt-3 bg-bg-elevated-3 border border-border-default rounded-lg px-4 py-3 text-sm text-text-secondary"></div>
                    <label class="flex items-center mt-4">
                        <input type="checkbox" name="enabled" value="true" class="form-checkbox"
                               {% if not job or job.enabled %}checked{% endif %}>
                        <span class="ml-3 text-text-secondary">Enabled (job runs on schedule)</span>
                    </label>
                </div>

                <!-- Options -->
                <div class="mb-6">
                    <h3 class="font-semibold text-lg mb-4 text-text-primary flex items-center">
                        <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-warning-500 text-white text-sm font-bold mr-2">4</span>
                        Syncoid Options
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                        <div>
                            <label class="form-label" for="compress">Compression</label>
                            <select name="compress" id="compress" class="form-select">
                                <option value="" {% if not job or not job.compress %}selected{% endif %}>Default</option>
                                <option value="lz4" {% if job and job.compress == 'lz4' %}selected{% endif %}>lz4</option>
                                <option value="zstd" {% if job and job.compress == 'zstd' %}selected{% endif %}>zstd</option>
                                <option value="gzip" {% if job and job.compress == 'gzip' %}selected{% endif %}>gzip</option>
                                <option value="xz" {% if job and job.compress == 'xz' %}selected{% endif %}>xz</option>
                                <option value="none" {% if job and job.compress == 'none' %}selected{% endif %}>none</option>
                            </select>
                        </div>
                        <div>
                            <label class="form-label" for="source_bwlimit">Source Bandwidth Limit</label>
                            <input type="text" name="source_bwlimit" id="source_bwlimit" class="form-input"
                                   value="{{ job.source_bwlimit if job and job.source_bwlimit else '' }}" placeholder="e.g., 10M, 1G">
                        </div>
                        <div>
                            <label class="form-label" for="target_bwlimit">Target Bandwidth Limit</label>
                            <input type="text" name="target_bwlimit" id="target_bwlimit" class="form-input"
                                   value="{{ job.target_bwlimit if job and job.target_bwlimit else '' }}" placeholder="e.g., 10M, 1G">
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <label class="flex items-center">
                            <input type="checkbox" name="recursive" value="true" class="form-checkbox" {% if job and job.recursive %}checked{% endif %}>
                            <span class="ml-3 text-text-secondary">Recursive (replicate child datasets)</span>
                        </label>
                        <label class="flex items-center">
                            <input type="checkbox" name="no_sync_snap" value="true" class="form-checkbox" {% if job and job.no_sync_snap %}checked{% endif %}>
                            <span class="ml-3 text-text-secondary">Don't create sync snapshots</span>
                        </label>
                        <label class="flex items-center">
                            <input type="checkbox" name="skip_parent" value="true" class="form-checkbox" {% if job and job.skip_parent %}checked{% endif %}>
                            <span class="ml-3 text-text-secondary">Skip parent dataset</span>
                        </label>
                        <label class="flex items-center">
                            <input type="checkbox" name="create_bookmark" value="true" class="form-checkbox" {% if job and job.create_bookmark %}checked{% endif %}>
                            <span class="ml-3 text-text-secondary">Create bookmarks</span>
                        </label>
                        <label class="flex items-center">
                            <input type="checkbox" name="force_delete" value="true" class="form-checkbox" {% if job and job.force_delete %}checked{% endif %}>
                            <span class="ml-3 text-text-secondary">Force delete conflicts</span>
                        </label>
                    </div>
                </div>

                <!-- Actions -->
                <div class="flex items-center justify-between pt-4 border-t border-border-subtle">
                    <button type="submit" class="btn-primary">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                        {% if job and job.id %}Save Changes{% else %}Create Job{% endif %}
                    </button>
                    <a href="/zfs/replication/syncoid" class="btn-secondary">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                        </svg>
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- How scheduling works -->
    <div class="card-nested bg-info-900/20 border-info-700">
        <h3 class="font-semibold mb-3 text-text-primary">How scheduled jobs run</h3>
        <ul class="space-y-2 text-sm text-text-secondary">
            <li>On Linux, each enabled job is registered as a systemd timer (webzfs-syncoid-job-ID.timer) that runs even when the browser is closed.</li>
            <li>On FreeBSD and NetBSD, jobs are registered in the root crontab inside a WebZFS-managed block.</li>
            <li>Remote jobs use the selected SSH Manager connection; the key and host details are resolved fresh at each run, so key rotation does not require editing jobs.</li>
            <li>If a run is still in progress when the next occurrence fires, the new occurrence is skipped and recorded as skipped.</li>
            <li>Results appear on the Replication History page.</li>
        </ul>
    </div>
</div>

<script>
(function() {
    const typeSelect = document.getElementById('replication_type');
    const connectionField = document.getElementById('connection-field');
    const presetSelect = document.getElementById('schedule_preset');
    const scheduleInput = document.getElementById('schedule');
    const scheduleStatus = document.getElementById('schedule-status');
    const nextRunsBox = document.getElementById('next-runs');
    let validateTimer = null;

    function updateConnectionVisibility() {
        const needsConnection = typeSelect.value === 'push' || typeSelect.value === 'pull';
        connectionField.classList.toggle('hidden', !needsConnection);
    }

    typeSelect.addEventListener('change', updateConnectionVisibility);
    updateConnectionVisibility();

    presetSelect.addEventListener('change', function() {
        if (this.value) {
            scheduleInput.value = this.value;
            validateSchedule();
        }
    });

    async function validateSchedule() {
        const expression = scheduleInput.value.trim();
        if (!expression) { return; }
        try {
            const response = await fetch('/zfs/replication/syncoid/jobs/validate-schedule', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ schedule: expression })
            });
            const data = await response.json();
            if (data.valid) {
                scheduleStatus.textContent = 'Valid schedule';
                scheduleStatus.className = 'text-success-400 text-xs mt-1';
                nextRunsBox.classList.remove('hidden');
                nextRunsBox.innerHTML = '<strong class="text-text-primary">Next runs:</strong> '
                    + data.next_runs.join(', ');
            } else {
                scheduleStatus.textContent = data.error || 'Invalid schedule';
                scheduleStatus.className = 'text-danger-400 text-xs mt-1';
                nextRunsBox.classList.add('hidden');
            }
        } catch (err) {
            scheduleStatus.textContent = 'Could not validate schedule';
            scheduleStatus.className = 'text-warning-400 text-xs mt-1';
        }
    }

    scheduleInput.addEventListener('input', function() {
        clearTimeout(validateTimer);
        validateTimer = setTimeout(validateSchedule, 500);
    });

    validateSchedule();
})();
</script>
{% endblock %}
