{% extends "layout.jinja" %}

{% set active_page = 'utils' %}

{% block content %}
<div class="container mx-auto px-4 py-8 max-w-4xl">
    <!-- Breadcrumb Navigation -->
    <nav class="text-sm mb-6 text-text-tertiary">
        <a href="/utils" class="hover:text-primary-400">Utilities</a>
        <span class="mx-2">/</span>
        <a href="/utils/scheduling" class="hover:text-primary-400">Scheduling</a>
        <span class="mx-2">/</span>
        <span class="text-text-primary">{% if task %}Edit Scrub Schedule{% else %}New Scrub Schedule{% endif %}</span>
    </nav>

    <!-- Page Header -->
    <div class="mb-6">
        <h1 class="text-3xl font-bold text-text-primary mb-2">
            {% if task %}Edit Scrub Schedule{% else %}New Scrub Schedule{% endif %}
        </h1>
        <p class="text-text-secondary text-sm">
            Runs zpool scrub on the selected pool. The schedule is registered with the operating system scheduler as soon as it is saved.
        </p>
    </div>

    <div class="card mb-6">
        <div class="card-body">
            <form method="post" action="/utils/scheduling/save">
                <input type="hidden" name="task_type" value="scrub">
                {% if task %}
                <input type="hidden" name="task_id" value="{{ task.id }}">
                {% endif %}

                <div class="mb-6">
                    <label class="form-label" for="pool">ZFS Pool</label>
                    <select name="pool" id="pool" class="form-select" required>
                        <option value="">Select a pool...</option>
                        {% for pool in pools %}
                        <option value="{{ pool }}" {% if task and task.pool == pool %}selected{% endif %}>{{ pool }}</option>
                        {% endfor %}
                    </select>
                    {% if task and task.pool and task.pool not in pools %}
                    <p class="text-warning-400 text-xs mt-1">
                        The pool this schedule refers to ({{ task.pool }}) is not currently imported.
                    </p>
                    {% endif %}
                </div>

                {% include 'utils/scheduling/schedule_fields.jinja' %}

                <div class="flex items-center justify-between pt-4 border-t border-border-subtle">
                    <button type="submit" class="btn-primary">
                        {% if task %}Save Changes{% else %}Create Schedule{% endif %}
                    </button>
                    <a href="/utils/scheduling" class="btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card-nested bg-info-900/20 border-info-700">
        <h3 class="font-semibold mb-2 text-text-primary">About scrub schedules</h3>
        <ul class="space-y-1 text-sm text-text-secondary">
            <li>A monthly scrub is enough for most pools. Weekly scrubs suit pools holding critical data.</li>
            <li>Scrubbing competes with normal workload for disk bandwidth, so prefer quiet hours.</li>
            <li>If a scrub from a previous run is still going, the runner leaves it alone instead of starting a second one.</li>
            <li>Current per-pool scrub state is on the <a href="/utils/scrub" class="text-primary-400 hover:text-primary-300">Scrub Status</a> page.</li>
        </ul>
    </div>
</div>
{% endblock %}
