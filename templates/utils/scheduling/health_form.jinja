{% extends "layout.jinja" %}

{% set active_page = 'utils' %}

{% block content %}
<div class="container mx-auto px-4 py-8 max-w-4xl">
    <!-- Breadcrumb Navigation -->
    <nav class="text-sm mb-6 text-text-tertiary">
        <a href="/utils" class="hover:text-primary-400">Utilities</a>
        <span class="mx-2">/</span>
        <a href="/utils/scheduling" class="hover:text-primary-400">Scheduling</a>
        <span class="mx-2">/</span>
        <span class="text-text-primary">{% if task %}Edit Health Check Schedule{% else %}New Health Check Schedule{% endif %}</span>
    </nav>

    <!-- Page Header -->
    <div class="mb-6">
        <h1 class="text-3xl font-bold text-text-primary mb-2">
            {% if task %}Edit Health Check Schedule{% else %}New Health Check Schedule{% endif %}
        </h1>
        <p class="text-text-secondary text-sm">
            Generates a health analysis report on a schedule. The schedule is registered with the operating system scheduler as soon as it is saved.
        </p>
    </div>

    <div class="card mb-6">
        <div class="card-body">
            <form method="post" action="/utils/scheduling/save">
                <input type="hidden" name="task_type" value="health">
                {% if task %}
                <input type="hidden" name="task_id" value="{{ task.id }}">
                {% endif %}

                <div class="mb-6">
                    <label class="form-label" for="name">Schedule Name</label>
                    <input type="text" name="name" id="name" class="form-input"
                           value="{{ task.name if task and task.name else '' }}"
                           placeholder="e.g., Weekly full health report">
                    <p class="text-text-tertiary text-xs mt-1">Used to identify this schedule in the task list.</p>
                </div>

                <div class="mb-6">
                    <h3 class="font-semibold text-lg mb-4 text-text-primary">Checks to Include</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <label class="flex items-center">
                            <input type="checkbox" name="check_disk_health" value="true" class="form-checkbox"
                                   {% if not task or task.check_disk_health %}checked{% endif %}>
                            <span class="ml-3 text-text-secondary">Check disk health</span>
                        </label>
                        <label class="flex items-center">
                            <input type="checkbox" name="check_smart_tests" value="true" class="form-checkbox"
                                   {% if not task or task.check_smart_tests %}checked{% endif %}>
                            <span class="ml-3 text-text-secondary">Check SMART test coverage</span>
                        </label>
                        <label class="flex items-center">
                            <input type="checkbox" name="check_scrubs" value="true" class="form-checkbox"
                                   {% if not task or task.check_scrubs %}checked{% endif %}>
                            <span class="ml-3 text-text-secondary">Check scrub status</span>
                        </label>
                        <label class="flex items-center">
                            <input type="checkbox" name="aggressive_hours" value="true" class="form-checkbox"
                                   {% if task and task.aggressive_hours %}checked{% endif %}>
                            <span class="ml-3 text-text-secondary">Aggressive power-on hour thresholds</span>
                        </label>
                    </div>
                </div>

                {% include 'utils/scheduling/schedule_fields.jinja' %}

                <div class="flex items-center justify-between pt-4 border-t border-border-subtle">
                    <button type="submit" class="btn-primary">
                        {% if task %}Save Changes{% else %}Create Schedule{% endif %}
                    </button>
                    <a href="/utils/scheduling" class="btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card-nested bg-info-900/20 border-info-700">
        <h3 class="font-semibold mb-2 text-text-primary">About health check schedules</h3>
        <ul class="space-y-1 text-sm text-text-secondary">
            <li>Each run produces a stored report, so a weekly schedule builds a history you can compare over time.</li>
            <li>Aggressive power-on hour thresholds flag disks earlier, which is useful for a fleet of aging drives.</li>
            <li>Reports appear on the <a href="/utils/health" class="text-primary-400 hover:text-primary-300">Health Analysis</a> page.</li>
        </ul>
    </div>
</div>
{% endblock %}
